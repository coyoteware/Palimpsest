{
  "name": "palimpsest",
  "version": "0.1.0",
  "description": "Open source PDF viewer and editor that runs as an installable Chromium app.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "app": "node scripts/launch.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "pdf-editor",
    "pwa",
    "chromium",
    "pdf.js"
  ]
}
