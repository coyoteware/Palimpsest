{
  "name": "palimpsest",
  "version": "0.1.0",
  "description": "Open source PDF viewer and editor: a small desktop app built with Tauri.",
  "license": "MIT",
  "author": "Coyoteware",
  "homepage": "https://github.com/coyoteware/Palimpsest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coyoteware/Palimpsest.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "pdf-editor",
    "pdf.js",
    "tauri",
    "desktop"
  ],
  "scripts": {
    "app": "tauri dev",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tauri build --debug --no-bundle --features e2e && vitest run -c vitest.e2e.config.ts",
    "dist": "tauri build --no-bundle",
    "dist:installer": "tauri build --bundles nsis",
    "icons": "node scripts/render-icons.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
